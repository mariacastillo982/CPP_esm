<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/cpp_ontology.owl"
         xmlns="http://example.org/cpp_ontology.owl#">

<owl:Ontology rdf:about="http://example.org/cpp_ontology.owl"/>

<owl:ObjectProperty rdf:about="#usesMechanism">
  <rdfs:domain rdf:resource="#CPP"/>
  <rdfs:range rdf:resource="#UptakeMechanism"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uses mechanism</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#delivers">
  <rdfs:domain rdf:resource="#CPP"/>
  <rdfs:range rdf:resource="#Cargo"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">delivers</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#involves">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#UptakeMechanism"/>
        <rdf:Description rdf:about="#CPP"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#MolecularPlayer"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">involves</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#targets">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#CPP"/>
        <rdf:Description rdf:about="#Cargo"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#SubcellularTarget"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">targets</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#interactsWith">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#MolecularPlayer"/>
        <rdf:Description rdf:about="#CPP"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#MolecularPlayer"/>
        <rdf:Description rdf:about="#CPP"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interacts with</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasGOTerm">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has GO term</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPmid">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has PubMed ID</rdfs:label>
</owl:DatatypeProperty>

